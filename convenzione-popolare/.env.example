# URL of the deployed Google Apps Script web app (ends with /exec)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbzCGgRJUN3ZBa_7Ukrrw_V7Yhr9pgAg6SjiQ6DK1rCekQi81Pr94Ezh6QDY9W6a3k3E/exec
# Same secret you put at the top of google-apps-script/Code.gs
SHEETS_SECRET=change-me-long-random-string
# Password to download the CSV at /api/export?key=...
ADMIN_KEY=change-me-another-secret
# Public URL of the site (used for share links + social previews)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Goal shown in the progress bar
NEXT_PUBLIC_GOAL=10000
# Optional: number added to the real count (leave 0 to show only real sign-ups)
BASE_COUNT=1000
